{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "format": {
      "type": "string",
      "const": "workspace-data-model"
    },
    "format_version": {
      "type": "number",
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "description": {
      "type": "string"
    },
    "entity_types": {
      "maxItems": 64,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "schema": {
            "type": "object",
            "required": [
              "$schema",
              "x-type-id",
              "x-version",
              "title",
              "x-icon",
              "type",
              "additionalProperties",
              "properties",
              "required",
              "x-title-template"
            ],
            "properties": {
              "$schema": {
                "const": "https://json-schema.org/draft/2020-12/schema"
              },
              "x-type-id": {
                "type": "string",
                "format": "uuid"
              },
              "x-version": {
                "type": "integer",
                "minimum": 1
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "x-icon": {
                "enum": [
                  "box",
                  "leaf",
                  "package",
                  "book",
                  "tool",
                  "star"
                ]
              },
              "description": {
                "type": "string"
              },
              "deprecated": {
                "type": "boolean"
              },
              "type": {
                "const": "object"
              },
              "additionalProperties": {
                "const": false
              },
              "properties": {
                "type": "object",
                "maxProperties": 64,
                "propertyNames": {
                  "pattern": "^prop_[1-9][0-9]*$"
                },
                "additionalProperties": {
                  "$schema": "https://json-schema.org/draft/2020-12/schema",
                  "type": "object",
                  "properties": {
                    "type": {
                      "anyOf": [
                        {
                          "type": "string",
                          "enum": [
                            "string",
                            "integer",
                            "number",
                            "boolean"
                          ]
                        },
                        {
                          "minItems": 2,
                          "maxItems": 2,
                          "type": "array",
                          "items": {
                            "anyOf": [
                              {
                                "type": "string",
                                "enum": [
                                  "string",
                                  "integer",
                                  "number",
                                  "boolean"
                                ]
                              },
                              {
                                "type": "string",
                                "const": "null"
                              }
                            ]
                          }
                        }
                      ]
                    },
                    "title": {
                      "type": "string",
                      "maxLength": 80
                    },
                    "description": {
                      "type": "string",
                      "maxLength": 1000
                    },
                    "format": {
                      "type": "string",
                      "const": "date"
                    },
                    "minLength": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4096
                    },
                    "maxLength": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 4096
                    },
                    "minimum": {
                      "type": "number"
                    },
                    "maximum": {
                      "type": "number"
                    },
                    "oneOf": {
                      "minItems": 1,
                      "maxItems": 128,
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "const": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 4096
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "title": {
                            "type": "string",
                            "maxLength": 80
                          }
                        },
                        "required": [
                          "const"
                        ],
                        "additionalProperties": false
                      }
                    },
                    "deprecated": {
                      "type": "boolean"
                    },
                    "readOnly": {
                      "type": "boolean"
                    },
                    "examples": {
                      "maxItems": 128,
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean",
                          "null"
                        ]
                      }
                    },
                    "multipleOf": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    },
                    "x-order": {
                      "type": "integer",
                      "exclusiveMinimum": 0,
                      "maximum": 9007199254740991
                    },
                    "default": {
                      "type": [
                        "string",
                        "number",
                        "boolean",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "x-order"
                  ],
                  "additionalProperties": false
                }
              },
              "required": {
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^prop_[1-9][0-9]*$"
                },
                "uniqueItems": true
              },
              "x-title-template": {
                "type": "string",
                "maxLength": 4096
              }
            },
            "additionalProperties": false
          },
          "identity": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "default_source": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "sources": {
                "minItems": 1,
                "maxItems": 64,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                    },
                    "rule_id": {
                      "type": "string",
                      "format": "uuid",
                      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                    },
                    "active": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "code",
                    "rule_id",
                    "active"
                  ],
                  "additionalProperties": false
                }
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "label",
              "default_source",
              "sources",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "ref",
          "schema",
          "identity"
        ],
        "additionalProperties": false
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "version": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "archived": {
            "default": false,
            "type": "boolean"
          },
          "ends": {
            "type": "array",
            "prefixItems": [
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "cardinality": {
                    "type": "string",
                    "enum": [
                      "one",
                      "many"
                    ]
                  },
                  "type_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label",
                  "cardinality",
                  "type_ref"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "cardinality": {
                    "type": "string",
                    "enum": [
                      "one",
                      "many"
                    ]
                  },
                  "type_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "label",
                  "cardinality",
                  "type_ref"
                ],
                "additionalProperties": false
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        },
        "required": [
          "id",
          "version",
          "archived",
          "ends"
        ],
        "additionalProperties": false
      }
    },
    "identity_definitions": {
      "type": "object",
      "properties": {
        "issuers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "active": {
                "type": "boolean"
              },
              "system": {
                "type": "boolean"
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "code",
              "label",
              "active",
              "system",
              "version"
            ],
            "additionalProperties": false
          }
        },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid",
                "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
              },
              "source": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,31}$"
              },
              "label": {
                "type": "string",
                "minLength": 1,
                "maxLength": 100
              },
              "meaning": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "generation": {
                "type": "string",
                "enum": [
                  "automatic",
                  "direct"
                ]
              },
              "active": {
                "type": "boolean"
              },
              "version": {
                "type": "integer",
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "id",
              "source",
              "label",
              "meaning",
              "generation",
              "active",
              "version"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "issuers",
        "rules"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "format",
    "format_version",
    "title",
    "entity_types",
    "relations",
    "identity_definitions"
  ],
  "additionalProperties": false,
  "title": "Workspace data model v1"
}
