{
  "name": "agent-workspace-template",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "setup:local": "node scripts/local-setup.mjs",
    "worker:entity-schema:local": "node scripts/entity-schema-worker-local.mjs",
    "stop:local": "supabase stop",
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "test:web": "vitest run",
    "test:adapters:fast": "deno test --config supabase/functions/deno.json supabase/tests/fast",
    "test:fast": "npm run test:core && npm run test:adapters:fast && npm run test:web",
    "check:docs": "node scripts/check-docs.mjs && node --test \"scripts/*.test.mjs\"",
    "check:deno": "deno check --config supabase/functions/deno.json supabase/functions supabase/tests && deno lint --config supabase/functions/deno.json supabase/functions supabase/tests && deno fmt --check --config supabase/functions/deno.json supabase/functions supabase/tests",
    "test:core": "deno test --config supabase/functions/deno.json supabase/functions/_shared",
    "test:db": "deno test --config supabase/functions/deno.json --allow-env --allow-net --allow-read --env-file=.env.local supabase/tests/database",
    "serve:functions": "supabase functions serve --env-file supabase/functions/.env",
    "test:http": "deno test --config supabase/functions/deno.json --allow-env --allow-net --allow-read --env-file=.env.local supabase/tests/http",
    "test:mcp": "deno test --config supabase/functions/deno.json --allow-env --allow-net --allow-read --env-file=.env.local supabase/tests/mcp",
    "test:e2e": "playwright test",
    "test:e2e:all": "node scripts/test-e2e-all.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:integration:local": "node scripts/test-local-integration.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@date-fns/utc": "2.1.1",
    "@fontsource-variable/geist": "5.3.0",
    "@js-temporal/polyfill": "0.5.1",
    "@supabase/supabase-js": "2.117.2",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.5.0",
    "date-fns": "4.4.0",
    "lucide-react": "1.59.0",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.5",
    "react-router": "8.4.0",
    "recharts": "3.8.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.22.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@babel/parser": "7.29.9",
    "@modelcontextprotocol/client": "2.2.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "deno": "2.9.6",
    "happy-dom": "21.0.3",
    "postgres": "3.4.9",
    "smol-toml": "1.9.0",
    "supabase": "2.119.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
