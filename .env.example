# 새 프로젝트의 설정 예시. 로컬 값은 `npm run setup:local`이 .env.local에 만든다.
# 실제 값과 비밀값은 커밋하지 않는다.

# 웹(브라우저 번들에 들어가는 공개 값만)
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://127.0.0.1:55421/functions/v1/api
# 개발용 이메일 로그인. 로컬 Supabase 주소일 때만 동작하며 운영 빌드에서는 비운다.
VITE_DEV_LOGIN=
# GitHub Pages의 저장소 경로(예: /agent-workspace-template/). 로컬은 비운다.
VITE_BASE=
