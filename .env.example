# 새 프로젝트의 설정 예시. 로컬 값은 `npm run setup:local`이 .env.local에 만든다.
# 실제 값과 비밀값은 커밋하지 않는다.

# 웹(브라우저 번들에 들어가는 공개 값만)
VITE_SUPABASE_URL=http://127.0.0.1:55421
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_API_URL=http://127.0.0.1:55421/functions/v1/api
# 사용 가이드의 설치/배포 문서를 연결할 공개 GitHub 저장소 URL(선택, 예: https://github.com/owner/repo).
# 이 저장소와 같은 plugins/workspace/README.md·docs/deployment/release.md 구조가 있는 앱 저장소를 지정한다.
VITE_REPOSITORY_URL=
# 공개해도 되는 제품 플러그인 설치 안내 HTTPS 주소. 비공개 저장소 주소 대신 사용할 수 있다.
VITE_PLUGIN_URL=
# 개발용 이메일 로그인. 로컬 Supabase 주소일 때만 동작하며 운영 빌드에서는 비운다.
VITE_DEV_LOGIN=
# GitHub Pages의 저장소 경로(예: /agent-workspace-template/). 로컬은 비운다.
VITE_BASE=

# 로컬 Google 로그인(선택): supabase/.env에 둔다. 서버 쪽 비밀값이므로 VITE_ 이름을 쓰지 않는다.
# Google Cloud의 OAuth 클라이언트(웹 애플리케이션), 승인된 리디렉션 URI: http://127.0.0.1:55421/auth/v1/callback
# SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
# SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Pinecone Inference의 서버 전용 키. 로컬에서는 supabase/functions/.env에 설정한다.
# .env.local의 기존 실험 키가 있으면 setup:local이 함수 설정으로 옮기며, 기존 함수 키를 우선한다.
# PINECONE_API_KEY=
# Stable nonsecret logical Pinecone account/project name. Preserve across API key rotation.
# PINECONE_ACCOUNT_SCOPE=
# APP_WORKER_PASSWORD·INDEX_WORKER_TOKEN·ENTITY_SCHEMA_WORKER_TOKEN은 setup:local이 생성·보존한다. VITE_에 넣지 않는다.
# ENTITY_SCHEMA_WORKER_TOKEN은 별도 32byte 무작위 내부 토큰이며 .env.local과 supabase/functions/.env에만 둔다.
# 로컬 분석 소비는 명시적으로 npm run worker:entity-schema:local을 실행할 때만 시작한다.
